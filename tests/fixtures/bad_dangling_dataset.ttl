# Adversarial fixture (a): :onDataset points at a URI that is never defined
# anywhere (not typed :Dataset, no rdfs:label). The SHACL gate MUST reject this
# via the sh:class :Dataset check on :onDataset.
@prefix :    <http://mlkg.local/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:paper_test_a a :Paper ;
    :title "Test Paper A" ;
    :year 2024 .

:src_test_a a :SourceLocation ;
    :fromPaper :paper_test_a ;
    :locator "Table 1" ;
    :page 1 .

:r_bad_dangling_dataset a :BenchmarkResult ;
    :reportsMethod :XGBoost ;
    :onDataset :ds_NONEXISTENT ;
    :usesMetric :CrossEntropyLoss ;
    :hasValue 1.0 ;
    :hasSource :src_test_a ;
    :conditionsComplete false .
