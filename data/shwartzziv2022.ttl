@prefix :    <http://mlkg.local/ontology#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:<http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# REVIEWED DATA — Shwartz-Ziv & Armon, "Tabular Data: Deep Learning is Not All
# You Need", Table 2 (first 6 of 11 datasets). Hand-reviewed from the source PDF.
#
# NOTE ON CONDITIONS (ADR-003): the paper's central experimental condition is
# whether each dataset was SEEN (in a deep model's own paper) or UNSEEN. That is
# per (model,dataset) and is NOT yet modeled here, so every result below is
# flagged :conditionsComplete false. The agent must caveat accordingly. It will
# be added in a refinement pass.
#
# NOTE ON METRIC SCALING: cross-entropy values carry a 100x factor (per the
# Table 2 caption). Stored as printed; the factor cancels in within-table
# comparisons. Rossmann uses MSE, not cross-entropy.
# =============================================================================

# --- Paper + source location ---
:paper_sz2022 a :Paper ;
    :title "Tabular Data: Deep Learning is Not All You Need" ;
    :author "Ravid Shwartz-Ziv" , "Amitai Armon" ;
    :year 2022 ;                      # Information Fusion (journal) version; source PDF is arXiv:2106.03253v2 (Nov 2021)
    :doi "10.1016/j.inffus.2021.11.011" .

:src_sz2022_t2 a :SourceLocation ;
    :fromPaper :paper_sz2022 ;
    :locator "Table 2" ;
    :page 6 .

# --- Paper-specific ensemble methods (general methods live in the ontology) ---
:SimpleEnsemble_sz2022    a :Method ; rdfs:label "Simple Ensemble (Shwartz-Ziv 2022)" .
:DeepEnsembleNoXGB_sz2022 a :Method ; rdfs:label "Deep Ensemble w/o XGBoost (Shwartz-Ziv 2022)" .
:DeepEnsembleXGB_sz2022   a :Method ; rdfs:label "Deep Ensemble w/ XGBoost (Shwartz-Ziv 2022)" .


# --- Datasets (characteristics as reported in Table 1) ---

:ds_rossmann a :Dataset ; rdfs:label "Rossmann Store Sales" ; :numFeatures 10 ; :numRows 1018000 .

:ds_covertype a :Dataset ; rdfs:label "Forest Cover Type" ; :numFeatures 54 ; :numRows 580000 ; :numClasses 7 .

:ds_higgs a :Dataset ; rdfs:label "Higgs Boson" ; :numFeatures 30 ; :numRows 800000 ; :numClasses 2 .

:ds_gas a :Dataset ; rdfs:label "Gas Concentrations" ; :numFeatures 129 ; :numRows 13900 ; :numClasses 6 .

:ds_eye a :Dataset ; rdfs:label "Eye Movements" ; :numFeatures 26 ; :numRows 10900 ; :numClasses 3 .

:ds_gesture a :Dataset ; rdfs:label "Gesture Phase" ; :numFeatures 32 ; :numRows 9800 ; :numClasses 5 .


# --- BenchmarkResults (48 = 8 models x 6 datasets) ---

:r_xgboost_rossmann a :BenchmarkResult ; :reportsMethod :XGBoost ; :onDataset :ds_rossmann ; :usesMetric :MSE ; :hasValue 490.18 ; :stdError 1.19 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_xgboost_covertype a :BenchmarkResult ; :reportsMethod :XGBoost ; :onDataset :ds_covertype ; :usesMetric :CrossEntropyLoss ; :hasValue 3.13 ; :stdError 0.09 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_xgboost_higgs a :BenchmarkResult ; :reportsMethod :XGBoost ; :onDataset :ds_higgs ; :usesMetric :CrossEntropyLoss ; :hasValue 21.62 ; :stdError 0.33 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_xgboost_gas a :BenchmarkResult ; :reportsMethod :XGBoost ; :onDataset :ds_gas ; :usesMetric :CrossEntropyLoss ; :hasValue 2.18 ; :stdError 0.2 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_xgboost_eye a :BenchmarkResult ; :reportsMethod :XGBoost ; :onDataset :ds_eye ; :usesMetric :CrossEntropyLoss ; :hasValue 56.07 ; :stdError 0.65 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_xgboost_gesture a :BenchmarkResult ; :reportsMethod :XGBoost ; :onDataset :ds_gesture ; :usesMetric :CrossEntropyLoss ; :hasValue 80.64 ; :stdError 0.8 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_node_rossmann a :BenchmarkResult ; :reportsMethod :NODE ; :onDataset :ds_rossmann ; :usesMetric :MSE ; :hasValue 488.59 ; :stdError 1.24 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_node_covertype a :BenchmarkResult ; :reportsMethod :NODE ; :onDataset :ds_covertype ; :usesMetric :CrossEntropyLoss ; :hasValue 4.15 ; :stdError 0.13 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_node_higgs a :BenchmarkResult ; :reportsMethod :NODE ; :onDataset :ds_higgs ; :usesMetric :CrossEntropyLoss ; :hasValue 21.19 ; :stdError 0.69 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_node_gas a :BenchmarkResult ; :reportsMethod :NODE ; :onDataset :ds_gas ; :usesMetric :CrossEntropyLoss ; :hasValue 2.17 ; :stdError 0.18 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_node_eye a :BenchmarkResult ; :reportsMethod :NODE ; :onDataset :ds_eye ; :usesMetric :CrossEntropyLoss ; :hasValue 68.35 ; :stdError 0.66 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

:r_node_gesture a :BenchmarkResult ; :reportsMethod :NODE ; :onDataset :ds_gesture ; :usesMetric :CrossEntropyLoss ; :hasValue 92.12 ; :stdError 0.82 ; :hasSource :src_sz2022_t2 ; :conditionsComplete false .

